<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ equivalent of backup_rules.xml. Include-only: the preference file
    travels, everything else stays on the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="pantegnos_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="pantegnos_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
